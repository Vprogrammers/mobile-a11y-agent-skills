{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.claude/settings.local.json)",
      "Read(./**/.claude/settings.local.json)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Read(./**/*.p8)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/local.properties)",
      "Read(./**/keystore.properties)",
      "Read(~/.gradle/gradle.properties)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.netrc)",
      "Read(./**/.netrc)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Bash(./gradlew *publish*)",
      "Bash(./gradlew *upload*)",
      "Bash(./gradlew *sign*)",
      "Bash(xcodebuild archive *)",
      "Bash(xcrun altool *)",
      "Bash(xcrun notarytool *)",
      "Bash(fastlane deliver *)",
      "Bash(fastlane pilot *)",
      "Bash(bundle exec fastlane *)",
      "Bash(firebase appdistribution:*)",
      "Bash(npm publish *)"
    ]
  }
}
