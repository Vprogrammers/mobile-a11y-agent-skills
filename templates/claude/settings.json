{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.claude/settings.local.json)",
      "Read(./**/.claude/settings.local.json)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p12)",
      "Read(./**/*.p8)",
      "Read(./**/*.mobileprovision)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(gh release *)",
      "Bash(./gradlew *publish*)",
      "Bash(./gradlew *upload*)",
      "Bash(./gradlew *sign*)",
      "Bash(xcodebuild archive *)",
      "Bash(xcrun altool *)",
      "Bash(xcrun notarytool *)",
      "Bash(fastlane deliver *)",
      "Bash(fastlane pilot *)",
      "Bash(npm publish *)"
    ]
  }
}
